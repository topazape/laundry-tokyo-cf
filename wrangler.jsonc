{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",

  "name": "laundry-tokyo",
  "main": "./build/worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "build": {
    "command": "make build",
  },
  "observability": {
    "enabled": true,
  },

  "triggers": {
    "crons": ["0 3 1 * *"],
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "eff246d6c8dd4e06bd35ac6fdb759e2f",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "laundry-tokyo",
    },
  ],
  "vars": {
    "PREF": "東京都", // 対象都道府県
    "MAX_SHOPS": "0", // 0 = 無制限。試験時 "50"
    "POLL_SPREAD_SEC": "55", // 全店への稼働状況リクエストをこの秒数に均等分散
    "POLL_CONCURRENCY": "8", // HTTP 同時リクエスト数の上限
    "USER_AGENT": "",
    "SHOP_INGEST_URL": "", // Pipelines stream (shop) の ingest endpoint
    "OBS_INGEST_URL": "", // Pipelines stream (obs) の ingest endpoint
  },
}
